@{
    //Added 2/22/2020 thomas downes
    string strRecipTypeName;  // Added 2/22/2020 td
    ciBadgeForWeb.Controllers.PersonalityController.SelectPersonality_Initialize();
    strRecipTypeName = ciBadgeForWeb.Controllers.PersonalityController.CurrentPersonality.ConfigNameBrief;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ABC ID Card by Thomas C. Downes</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/Scripts/Closures/ClickClosure.js")
    @Scripts.Render("~/Scripts/Closures/DragClosure.js")
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @*                @Html.ActionLink("ABC ID Card", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })*@
            </div>
            <div class="navbar-collapse collapse">

                @*https://stackoverflow.com/questions/42506595/mvc5-razor-check-session-value*@

                @if (Session["UserName"] != null || Session["UserID"] != null)
                {

                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Home", "Index", "Home")</li>
                        @*<li>@Html.ActionLink("About", "About", "Home")</li>*@
                        <li>@Html.ActionLink("Contact", "Contact", "Home")</li>
                        <li>@Html.ActionLink("Customers", "Index", "Customer")</li>
                        <li>@Html.ActionLink("Personalities", "Index", "Personality")</li>
                        <li>@Html.ActionLink("Badge Layout", "Index", "LayoutText1")</li>

                        @*<li>@Html.ActionLink("Students/Employees", "Index", "Recipient")</li>*@
                        @*<li>@Html.ActionLink("Students", "Index_Cfg1", "Recipient")</li>
                            <li>@Html.ActionLink("Staff", "Index_Cfg2", "Recipient")</li>*@
                        <li>@Html.ActionLink(strRecipTypeName, "Index_CurrCfg", "Recipient")</li>

                        <li>@Html.ActionLink("Example of Badge", "Example", "Home")</li>
                        @*<li>@Html.ActionLink("Steps 1 and 2", "Edit", "Steps1and2")</li>*@

                        @*                    <li>@Html.ActionLink("Moveable Divs", "Index", "JsonFile")</li>*@

                        <li>
                            <!-- https://www.w3schools.com/bootstrap/bootstrap_dropdowns.asp -->
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown">
                                    Moveable Divs
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>@Html.ActionLink("Proof of Concept", "Index", "JsonFile")</li>
                                    <li>@Html.ActionLink("JSON strings", "TableEdit", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Left", "TableDivsLeft", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Top", "TableDivsTop", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Width", "TableDivsWidth", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Height", "TableDivsHeight", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - HasField", "TableDivsHasField", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Displayed", "TableDivsDisplayed", "JsonFile")</li>
                                    <li>@Html.ActionLink("Element-Location - Fieldname", "TableDivsFieldName", "JsonFile")</li>
                                </ul>
                            </div>
                        </li>

                        <li>
                            <!-- https://www.w3schools.com/bootstrap/bootstrap_dropdowns.asp -->
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" data-toggle="dropdown">
                                    Miscellaneous
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>@Html.ActionLink("Upload", "Index", "UploadBack")</li>
                                    <li>@Html.ActionLink("Xml Caching", "Index", "XmlCache")</li>
                                    <li>@Html.ActionLink("Orange Coast", "Index", "OrangeCoast")</li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                }

            </div>
        </div>
    </div>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ABC ID Card by Thomas C. Downes</p>
        </footer>
    </div>

