 @* Goes in Views\PersonList *@
@*@using EditableListMvc.Models*@
@*@using ciBadgeForWeb.Models*@
@using ciBadgeForWeb.Models

@*@model IEnumerable<Person>*@
@*@model IEnumerable<ciBadgeFields.ClassFieldAny>*@
@model IEnumerable<ciBadgeForWeb.Models.Field>

@*
    @    //  https://gist.github.com/rockfordlhotka/0474af9cf53cec9f2d359fa413d61e73
*@

@{
    //
    //  https://gist.github.com/rockfordlhotka/0474af9cf53cec9f2d359fa413d61e73
    //
    //ViewBag.Title = "Person List";
    ViewBag.Title = "List of Fields";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Added 11/24/2021 thomas d.

    //Added 11/27/2021 td
    ciBadgeCachePersonality.ClassElementsCache_Deprecated.Singleton
        .RefreshListOfBadgeDisplayElements_Flds(true, true);

}

@*<h2>Person List</h2>*@
<h2>Field List</h2>

@*@using (Html.BeginForm("Index", "PersonList", FormMethod.Post))*@
@using (Html.BeginForm("Index", "FieldList", FormMethod.Post))
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @* @Html.DisplayNameFor(model => model.FirstName)*@
                    @Html.DisplayNameFor(model => model.FieldLabelCaption)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CIBadgeField)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsDisplayedOnBadge)
                </th>
                @*<th>
            @Html.DisplayNameFor(model => model.Remove)
        </th>*@
                <th>
                    Image by Handler
                </th>
                <th>
                    Hidden Fields
                </th>
            </tr>
        </thead>
        <tbody id="childtable">
            @Html.EditorFor(model => Model)
        </tbody>
    </table>

    <p>
        <input name="command" type="submit" value="Add Item" />
        <input name="command" type="submit" value="Remove Selected" />
        <input name="command" type="submit" value="Cancel Edits/Refresh" />
    </p>
    <p>
        @Html.ValidationSummary()
        <input name="command" type="submit" value="Submit/Save" />
    </p>
}