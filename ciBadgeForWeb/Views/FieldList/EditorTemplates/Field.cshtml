@* Goes in Views\PersonList\EditorTemplates *@
@*@using EditableListMvc.Models*@
@*@model Person*@
@*@model ciBadgeFields.ClassFieldAny*@
@model ciBadgeForWeb.Models.Field

@*
    //  https://gist.github.com/rockfordlhotka/0474af9cf53cec9f2d359fa413d61e73
*@

<tr>
    <td>
        @Html.DisplayFor(model => model.FieldLabelCaption)
    </td>
    <td>
        [ @Html.DisplayFor(model => model.CIBadgeField) ]
    </td>
    <td>
        @Html.EditorFor(model => model.IsDisplayedOnBadge)
    </td>
    @*<td>
            Remove button
        </td>*@
<td>
    <img src="~/ASPX/Step2DataHandler.ashx?fldindex=@Model.FieldIndex&fldcaption=@Model.FieldLabelCaption" />
    # @Model.FieldIndex __Caption: @Model.FieldLabelCaption __BugMessage: @Model.BugMessages[@Model.FieldIndex]
      @Model.BadgeElement.LabelText_ToDisplay(false)
</td>

<td>
    <!--                                                 -->
    <!-- Anonymous Type.... new { id = @Model.FieldIndex } -->
    <!--                                                 -->
    @*@Html.ActionLink("Edit This Field", "Edit", "Fields",
            new { id = @Model.FieldIndex, isAnonymousType = true })*@
    @Html.ActionLink("Edit This Field", "Edit", "Fields",
                           new { id = @Model.FieldIndex },
                           new { @class = "name" } )

    @Html.HiddenFor(model => model.CIBadgeField)
    @Html.HiddenFor(model => model.DefaultValue)
    @Html.HiddenFor(model => model.ExampleValue)
    @Html.HiddenFor(model => model.FieldEnumValue)
    @Html.HiddenFor(model => model.FieldIndex)
    @Html.HiddenFor(model => model.FieldLabelCaption)
    @Html.HiddenFor(model => model.FieldType_TD)
    @Html.HiddenFor(model => model.HasPresetValues)
    @Html.HiddenFor(model => model.IsAdditionalField)
    @Html.HiddenFor(model => model.IsBarCode)
    @Html.HiddenFor(model => model.IsCustomizable)
    @Html.HiddenFor(model => model.IsDateField)
    @Html.HiddenFor(model => model.IsDisplayedForEdits)
    @*@Html.HiddenFor(model => model.IsDisplayedOnBadge)*@
    @Html.HiddenFor(model => model.IsFieldForDates)
    @Html.HiddenFor(model => model.IsLinkedToSections)
    @Html.HiddenFor(model => model.IsLocked)
    @Html.HiddenFor(model => model.IsStandard)
    @Html.HiddenFor(model => model.OtherDbField_Optional)
    @Html.HiddenFor(model => model.Text_orDate)
</td>



</tr>