    //string sCurrentXmlFilename = "";
}

<h2>List of Saved Cache Files</h2>

@*<!DOCTYPE html>

    <html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>ShowSavedCaches</title>
    </head>
    <body>*@

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    //Added 2/04/2020 td;
    bool bCurrentXmlCache = false;
    string sCurrentXmlFilename = "";

    @*<h2>List of Saved Cache Files</h2>*@

    {
        string strPathToFolderXML = ciBadgeForWeb.App_Start.DiskFolders.PathToFolder_XML(true);
        int intFileNumber = 0;

        foreach (FileInfo each_file_Info in (new DirectoryInfo(strPathToFolderXML)).GetFiles("*.xml"))
        {
            //We have to remove the file extension, first.
            string strXmlFile_NoExt = each_file_Info.Name.Replace(".xml", "");
            intFileNumber += 1;

            <div>
                @*<a href="~/XmlCache?XmlCacheFile=@each_file_Info.Name">@each_file_Info.Name</a>*@

                <p>
                    XML File # @intFileNumber is:
                    <a href="~/XmlCache/LoadOneSavedCache/@strXmlFile_NoExt">
                        @each_file_Info.Name
                    </a>

                    @{
                        //
                        //Added 2/4/2020 thomas downes
                        //
                        //sCurrentXmlFilename = ciBadgeElements.ClassElementsCache_Deprecated.Singleton.PathToXml_Saved;
                        sCurrentXmlFilename = ciBadgeElements.ClassElementsCache_Deprecated.Singleton.XmlFile_FTitle;
                        bCurrentXmlCache = (each_file_Info.Name == sCurrentXmlFilename);
                    }
                    @if (bCurrentXmlCache)
                    {
                        //Added 02/04/2020 thomas d.
                        @Html.Raw("   << This one is currently selected.");
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <button type="submit" value="SaveThisCache" class="btn btn-default">
                                    Save this cache
                                </button>
                            </div>
                        </div>
                    }
                </p>
            </div>
        }

    }
}

@*</body>
    </html>*@
