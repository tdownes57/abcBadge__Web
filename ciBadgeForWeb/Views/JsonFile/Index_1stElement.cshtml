@model ciBadgeForWeb.Models.MoveableDivImage

@{
    ViewBag.Title = "MoveableDivImage";

    //<!-- Really fucking important.....                         -->
    //<!--    Otherwise, the Batch Setup elements won't move.... -->
    //<!--      ----11/23/2021 thomas downes                     -->
    //<!--                                                       -->
    //Layout = "~/Views/Shared/_LayoutClosures.cshtml";
    Layout = "~/Views/Shared/_LayoutBadgeSetup.cshtml";
     
    //---Layout = "";
    // Added 11/4/2021 thomas downes
    int intCurrBackIndex = ciBadgeForWeb.Models.Background.CurrentIndex_RunChecks();

    const bool mod_c_bTestStep2Handler = true;  // Added 11/10/2021 Thomas Downes 
}

@*<script src="//code.jquery.com/jquery-2.1.1.min.js" type="text/javascript"></script>*@

@*<h1>User-Moveable Division-Image Elements</h1>
    <p><a href="https://www.w3schools.com/howto/howto_js_draggable.asp">https://www.w3schools.com/howto/howto_js_draggable.asp</a></p>
    <p><a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Closures">Javascript Closures by Mozilla</a></p>
    <p><a href="~/JS_Moveable_Divs_HTM/drag_elements_JSON_groups.htm">my HTML work</a></p>*@

<h3 id="paragraphToggleMode">
    Move Mode - Click and hold the mouse button
    down while moving the DIV element.
</h3>
<h4> <a id="hyperlinkToggleMode" href="">Click here to switch to Include Mode.</a> </h4>

<div id="div_Width2x" style="visibility: hidden; border: dotted;">
    Click here to increase by 50% the width of Included items.
</div>

<div style="position: absolute; top: @ViewBag.OffsetLeftPixels ;
                                left: @ViewBag.OffsetRightPixels ;
                                border-width: thick;  z-index:-1;">
 
    <img src="~/ASPX/BackHandler.ashx?big=y&hor=y&width=400&backid=@intCurrBackIndex"
         width="@ViewBag.LayoutWidthPixels"
         height="@ViewBag.LayoutHeightPixels" />
    <br />
    <img src="~/Images/DropboxToResizeEtc.jpg" />
</div>

@if (mod_c_bTestStep2Handler)
{
<div id="EL1" class="mydiv_class" style="position: absolute; top: 250px; left: 100px; border-width: thick; ">
    @* <img id="EL1_im" src="@Url.Content("~/Images/blue_star1.jpg")" width="200" height="35" />*@
    <img id="EL1_im" src="~/ASPX/Step2DataHandler.ashx?elemindex=1" /> @*width="200" height="35" />*@
    @Model.BugMessages[1];
</div>
}
else
{
<div id="EL1" class="mydiv_class" style="position: absolute; top: 250px; left: 100px; border-width: thick; ">
    @* <img id="EL1_im" src="@Url.Content("~/Images/blue_star1.jpg")" width="200" height="35" />*@
    <img id="EL1_im" src="@Model.GetImageString_Base64(1)" /> @*width="200" height="35" />*@
    @Model.BugMessages[1];
</div>
}

