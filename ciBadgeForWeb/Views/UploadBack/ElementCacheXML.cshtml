
@{
    ViewBag.Title = "ElementCacheXML";
    Layout = "~/Views/Shared/_LayoutUpload.cshtml";
}

<h2>Upload Element Cache XML</h2>

<form runat="server">
    <input type='file' id="imgInp" />
    <img id="blah" src="#" alt="your image" />
</form>

@using (Html.BeginForm("FileUpload", "UploadBack", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary();
    <ol>
        <li class="lifile">
            <input type="file" id="fileToUpload" name="file" />
            <span class="field-validation-error" id="spanfile"></span>
            <img id="blah_preview" src="#" alt="your image" />
        </li>
    </ol>

    <input type="submit" id="btnSubmit" value="Upload" />

    @*<input type='file' id="imgInp" />
        <img id="blah" src="#" alt="your image" />*@
}



