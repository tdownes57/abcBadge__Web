@using (Html.BeginForm(actionName: "UploadNewPic",
              controllerName: "Recipient",
              routeValues: new { RecipientID = @Model.RecipientID },
              method: FormMethod.Post,
              htmlAttributes: new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary();

    @*<h2>Recipient @Model.FirstName @Model.LastName (ID @Model.RecipientID)</h2>*@
    <h2>@strRecipTypeName @Model.FirstName @Model.LastName (ID @Model.RecipientID)</h2>

    <img alt="Image Handler" width="100" src="~/ASPX/ImageHandler.ashx?id=@Model.RecipientID" />

    <ol>
        <li class="lifile">
            @*<input type="file" id="fileToUpload" name="file" />*@
            <input type="file" id="fileToUpload" name="file" />
            <span class="field-validation-error" id="spanfile"></span>
            <img id="blah_preview" src="#" alt="your image" />
            <img id="blah" src="#" alt="your image" />
        </li>
    </ol>

    <input type="hidden" id="RecipientID" name="RecipientID" value=@Model.RecipientID />

    <input type="submit" id="btnSubmit" value="Upload" />

    <p>@ViewBag.Message</p>

    @*<input type='file' id="imgInp" />
        <img id="blah" src="#" alt="your image" />*@
}


