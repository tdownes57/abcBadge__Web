@model ciBadgeForWeb.Models.CIRecipient

@{
    ViewBag.Title = "UploadNewPic";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string strRecipTypeName;  // Added 2/22/2020 td
    ciBadgeForWeb.Controllers.PersonalityController.SelectPersonality_Initialize();
    strRecipTypeName = ciBadgeForWeb.Controllers.PersonalityController.CurrentPersonality.ConfigNameBrief;

    //Added 2-23-2020 td
    //   Change "Students" to "Student", but leave "Actress"
    //   (or "Stewardess") alone.
    //
    strRecipTypeName = (strRecipTypeName.EndsWith("ss") ? strRecipTypeName :
                         strRecipTypeName.EndsWith("s") ? strRecipTypeName
                         .Substring(0, -1 + strRecipTypeName.Length) :
                         strRecipTypeName);

}

