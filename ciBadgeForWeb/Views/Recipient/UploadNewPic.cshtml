@model ciBadgeForWeb.Models.CIRecipient
 
@{
    ViewBag.Title = "UploadNewPic";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string strRecipTypeName;  // Added 2/22/2020 td
    ciBadgeForWeb.Controllers.PersonalityController.SelectPersonality_Initialize();
    strRecipTypeName = ciBadgeForWeb.Controllers.PersonalityController.CurrentPersonality.ConfigNameBrief; 

        //Added 2-23-2020 td
    //   Change "Students" to "Student", but leave "Actress"
    //   (or "Stewardess") alone.  
    //
    strRecipTypeName = (strRecipTypeName.EndsWith("ss") ? strRecipTypeName : 
                         strRecipTypeName.EndsWith("s") ? strRecipTypeName
                         .Substring(0, -1 + strRecipTypeName.Length) : 
                         strRecipTypeName);

}

<h2>.</h2>
<h2>Upload New Portrait Photo</h2>

<a href="https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4">https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4</a>

<a href="https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4">https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4</a>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>


@*<script type="text/jscript">*@
<script>
    //
    //   https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4
    //

    //get file size
    function GetFileSize(fileid) {
        try {
            var fileSize = 0;
            //for IE
            // 2-23-2020 thomas downes//if ($.browser.msie) {
            //
            // https://stackoverflow.com/questions/14892095/browser-msie-error-after-update-to-jquery-1-9-1
            //
            if (navigator.userAgent.toLowerCase().indexOf('msie 6') != -1) {
                //before making an object of ActiveXObject,
                //please make sure ActiveX is enabled in your IE browser
                var objFSO = new ActiveXObject("Scripting.FileSystemObject"); var filePath = $("#" + fileid)[0].value;
                var objFile = objFSO.getFile(filePath);
                var fileSize = objFile.size; //size in kb
                fileSize = fileSize / 1048576; //size in mb
            }
            //for FF, Safari, Opeara and Others
            else {
                fileSize = $("#" + fileid)[0].files[0].size //size in kb
                fileSize = fileSize / 1048576; //size in mb
            }
            return fileSize;
        }
        catch (e) {
            alert("Error is :" + e);
        }
    }

    //get file path from client system
    function getNameFromPath(strFilepath) {
        var objRE = new RegExp(/([^\/\\]+)$/);
        var strName = objRE.exec(strFilepath);

        if (strName == null) {
            return null;
        }
        else {
            return strName[0];
        }
    }

    $("#btnSubmit").on("click", function () {
        if ($('#fileToUpload').val() == "") {
            $("#spanfile").html("Please upload file");
            return false;
        }
        else {
            return checkfile();
        }
    });

    function checkfile() {
        var file = getNameFromPath($("#fileToUpload").val());
        if (file != null) {
            var extension = file.substr((file.lastIndexOf('.') + 1));
            // alert(extension);
            switch (extension) {
                case 'JPG':
                case 'PNG':
                case 'GIF':
                case 'BMP':
                case 'jpg':
                case 'png':
                case 'gif':
                case 'bmp':
                    flag = true;
                    break;
                default:
                    flag = false;
            }
        }
        if (flag == false) {
            $("#spanfile").text("You can upload only jpg,png,gif,pdf extension file");
            return false;
        }
        else {
            var size = GetFileSize('fileToUpload');
            if (size > 3) {
                $("#spanfile").text("You can upload file up to 3 MB");
                return false;
            }
            else {
                $("#spanfile").text("");
            }
        }
    }

    $(function () {
        $("#fileToUpload").change(function () {
            checkfile();
        });
    });

    //
    //  End of https://www.dotnettricks.com/learn/mvc/how-to-upload-a-file-in-mvc4
    //


    //
    //Start of https://stackoverflow.com/questions/4459379/preview-an-image-before-it-is-uploaded
    //

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#blah_preview').attr('src', e.target.result);
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    $("#fileToUpload").change(function () {
        readURL(this);
    });

        //
    //End of https://stackoverflow.com/questions/4459379/preview-an-image-before-it-is-uploaded
    //

</script>

