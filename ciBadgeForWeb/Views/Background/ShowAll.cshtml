@model IEnumerable<ciBadgeForWeb.Models.Background>

@{
    ViewBag.Title = "ShowAll";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Added 11/2/2021 td
    //  )) string PathToFolder_Backs =
    //  ))   Html.Resolve(ciBadgeForWeb.App_Start.DiskFolders.PathToFolderWithBacks(false));
    string PathToFolder_Backs =
        Url.Content(ciBadgeForWeb.App_Start.DiskFolders.PathToFolderWithBacks(false));

}

<h2>ShowAll</h2>

<p>
    @Html.ActionLink("Create New / Upload Background Image", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Index)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FileName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @*<p>Show checkbox for selection as badge-layout background.</p>*@
            @Html.DisplayNameFor(model => model.IsSelectedForBadge)
        </th>
        <th>
            @*<p>Show checkbox for hiding/preventing selection as badge-layout background.</p>*@
            @Html.DisplayNameFor(model => model.IsSuppressedFromSelection)
        </th>
        <th >
            Action Links
        </th>
        <th width="415">
            Background Image
        </th>
    </tr>

    @foreach (var item in Model)
    {
<tr>
    <!--<td>
        <p>
            @* Using the Step4Handler.ashx to generate the background, with a width of 400 pixels.<br />*@
            @*<img src="~/ASPX/Step4Handler.ashx?id=back&big=y&hor=y&width=400&backid=@item.Index"
                width="400" />*@
            @*[[img src="~/ASPX/BackHandler.ashx?big=y&hor=y&width=400&backid=@item.Index"
                width="400" ]] <br />*@
            @*<img src="~/ASPX/BackHandler.ashx?big=y&hor=y&width=400&backid=@item.Index"
                width="400" />*@
            <!--<img src="~/ASPX/BackHandler.ashx?big=y&hor=y&width=400&backid=@item.Index" />
        </p>
    </td>-->
    <td>
        @Html.DisplayFor(modelItem => item.Index)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.FileName)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Description)
    </td>
    <td>
        @*<p>Show checkbox for selection as badge-layout background.</p>*@
        @Html.DisplayFor(modelItem => item.IsSelectedForBadge)
    </td>
    <td>
        @*<p>Show checkbox for hiding/preventing selection as badge-layout background.</p>*@
        @Html.DisplayFor(modelItem => item.IsSuppressedFromSelection)
    </td>
    <td>
        @Html.ActionLink("Select Background", "Select", new { id = item.Index })
        @Html.ActionLink("Edit", "Edit", new { id = item.Index })
        @*@Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ })*@ |
        @Html.ActionLink("Delete", "Delete", new { id = item.Index })
    </td>
    <td>
        @*<img src="~/ASPX/BackHandler.ashx?big=y&hor=y&width=400&backid=@item.Index" />*@
        <img src="~/ASPX/BackHandler.ashx?big=y&hor=y&height=300&backid=@item.Index" />
    </td>
</tr>
    }

</table>


